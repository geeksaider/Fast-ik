  users ||--o{ notifications : receives
  users ||--o{ messages : sends
  users ||--o{ admin_actions : performs

  categories ||--o{ jobs : groups
  categories ||--o{ skills : groups
  categories ||--o{ contests : groups
  users ||--o{ jobs : creates
  jobs ||--o{ applications : receives
  users ||--o{ applications : sends
  jobs ||--o{ job_invites : has
  users ||--o{ job_invites : sends
  users ||--o{ job_invites : receives

  users ||--o{ orders : customer
  users ||--o{ orders : performer
  jobs ||--o{ orders : creates
  orders ||--o{ reviews : receives
  users ||--o{ reviews : writes
  users ||--o{ reviews : gets

  conversations ||--o{ messages : contains
  conversations ||--o{ message_attachments : contains
  messages ||--o{ message_attachments : owns

  performer_levels ||--o{ performer_progress : current_level
  users ||--o{ performer_progress : progresses
  users ||--o{ xp_events : earns
  performer_levels ||--o{ xp_events : references
  users ||--o{ elite_interviews : candidate
  users ||--o{ elite_interviews : reviewer

  users ||--o{ user_skills : has
  skills ||--o{ user_skills : selected
  users ||--o{ portfolio_items : owns


{$FASTIK_DOMAIN} {
  encode zstd gzip

  @blockedRegister {
    method POST
    path /api/auth/register
  }

  handle @blockedRegister {
    respond "Регистрация временно ограничена. Попробуйте позже." 429
  }

  @blockedImageWrites {
    method PUT POST
    path /api/profile/me /api/profile/me/portfolio* /api/conversations/*/messages
  }

  handle @blockedImageWrites {
    respond "Загрузка изображений и вложений временно ограничена." 429
  }

  handle /api/* {
    reverse_proxy api:4200
  }

  handle /docs* {
    reverse_proxy api:4200
  }

  handle /openapi.json {
    reverse_proxy api:4200
  }

  handle {
    reverse_proxy web:80
  }
}
